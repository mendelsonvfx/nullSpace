{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "nullSpace",
    "version": "1.6.4"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeFile": true,
        "removeDir": true,
        "copyFile": true,
        "scope": [
          "**"
        ]
      },
      "dialog": {
        "all": true
      },
      "path": {
        "all": true
      },
      "clipboard": {
        "all": false,
        "writeText": true,
        "readText": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true,
        "setResizable": true,
        "setTitle": true,
        "setFullscreen": true
      }
    },
    "bundle": {
      "active": true,
      "targets": [
        "msi",
        "nsis"
      ],
      "identifier": "nullspace.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "templates/*"
      ],
      "windows": {
        "nsis": {
          "installerIcon": "icons/icon.ico"
        }
      },
      "externalBin": []
    },
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.exchangerate-api.com; img-src 'self' data: blob: asset: https://asset.localhost https://www.google.com https://*.gstatic.com; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "visible": false,
        "fullscreen": false,
        "resizable": true,
        "title": "nullSpace",
        "width": 1920,
        "height": 900,
        "minWidth": 1520,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "fileDropEnabled": false
      }
    ]
  }
}